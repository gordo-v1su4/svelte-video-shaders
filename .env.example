# Server-side keys (used by /api/transcribe and /api/story routes)

# Deepgram - lyric/SRT extraction from vocal stems
DEEPGRAM_API_KEY=
# Optional overrides
# DEEPGRAM_MODEL=nova-3
# DEEPGRAM_LANGUAGE=en

# Kimi / Moonshot - AI story beat generation
KIMI_API_KEY=
# or: MOONSHOT_API_KEY=
# Optional overrides
# KIMI_API_BASE=https://api.moonshot.ai/v1
# KIMI_API_PROTOCOL=openai
# KIMI_MODEL=kimi-k2.6

# Client-side (exposed to the browser - VITE_ prefix)

# Essentia audio analysis API (beats, BPM, sections, energy)
VITE_ESSENTIA_API_URL=
VITE_ESSENTIA_API_KEY=
