# Copy to `.env` for local dev. One file is enough.
#
# `.env.local` is sometimes created by `vercel env pull` — it overrides `.env` and
# splits keys across files. You can delete `.env.local` and keep everything here.
#
# Restart the dev server after changes: bun run dev

# --- Essentia (beats, BPM, sections) — browser calls API directly ---
VITE_ESSENTIA_API_URL=https://essentia.v1su4.dev
VITE_ESSENTIA_API_KEY=
ESSENTIA_API_KEY=

# --- Deepgram (vocal stem → lyrics) — server proxy + browser for large files ---
DEEPGRAM_API_KEY=
# DEEPGRAM_MODEL=nova-3
# DEEPGRAM_LANGUAGE=en

# --- Kimi / Moonshot (story beats) — server /api/story only ---
KIMI_API_KEY=
# MOONSHOT_API_KEY=
# KIMI_MODEL=kimi-k2.6
# KIMI_API_BASE=https://api.moonshot.ai/v1
# KIMI_API_PROTOCOL=openai
